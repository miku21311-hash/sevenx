{
  "name": "sevenx_api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../.env dist/main.js",
    "check": "tsc --noEmit",
    "test": "jest",
    "seed": "tsx --env-file-if-exists=../.env scripts/seed.ts",
    "schema:print": "tsx src/print-schema.ts"
  },
  "dependencies": {
    "@trpc/client": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "erxes-api-shared": "npm:@erxes/api-shared@3.3.4",
    "graphql": "^16.14.2",
    "graphql-tag": "^2.12.7",
    "mongoose": "8.13.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@apollo/subgraph": "^2.15.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.4",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.7",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
