{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "resolveJsonModule": true,
    "types": [
      "node",
      "jest"
    ],
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "~": [
        "./src"
      ],
      "@/*": [
        "./src/modules/*"
      ],
      "@": [
        "./src/modules"
      ]
    }
  },
  "include": [
    "src",
    "rspack.config.ts"
  ]
}
